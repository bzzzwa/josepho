{
  "name": "josepho",
  "version": "0.1.0",
  "description": "Josepho - a tiny-resolution platformer where waking prisms brings color back to a grey world. Chapter 1: Svitani.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,mdc,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,mdc,yml,yaml}\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "blit386": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@blit386/kit": "^1.7.0",
    "prettier": "^3.9.6",
    "vite": "^8.0.16"
  }
}
